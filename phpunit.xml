<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Keep the test suite deterministic and never call live provider APIs. -->
        <env name="EGOV_SSO_BASE_URL" value="http://localhost:3000/egovph/sso" force="true"/>
        <env name="EGOV_EVERIFY_BASE_URL" value="http://localhost:3000/egovph/everify" force="true"/>
        <env name="EGOV_AI_BASE_URL" value="http://localhost:3000/egovph/ai" force="true"/>
        <env name="EGOV_FACE_LIVENESS_BASE_URL" value="http://localhost:3000/egovph/face-liveness" force="true"/>
        <env name="EGOV_CHAIN_BASE_URL" value="http://localhost:3000/egovph/egovchain" force="true"/>
        <env name="EGOV_REPORT_BASE_URL" value="http://localhost:3000/egovph/ereport" force="true"/>
        <env name="EGOV_COMPASS_BASE_URL" value="http://localhost:3000/egovph/compass" force="true"/>
        <env name="EGOV_ENABLE_LIVE_MUTATIONS" value="false" force="true"/>
    </php>
</phpunit>
